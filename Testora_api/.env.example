APP_ENV=development
API_PREFIX=/api
APP_TIMEZONE=Asia/Bangkok
MONGODB_URI=
MONGODB_DATABASE=testora
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
SUBSCRIPTION_SELF_SERVICE_ENABLED=false
FRONTEND_URL=http://localhost:4200

# Bank-transfer payments. Keep these values only in Render environment variables.
PAYMENT_PROVIDER=disabled
PAYMENT_BANK_CODE=ACB
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ORDER_EXPIRE_MINUTES=30
PAYMENT_PRO_PRICE_VND=99000
PAYMENT_MAX_PRICE_VND=249000
SEPAY_WEBHOOK_API_KEY=

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ATLAS_VECTOR_INDEX=document_chunks_vector

RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_10_MINUTES=10
RATE_LIMIT_AI_PER_MINUTE=5
RATE_LIMIT_QUIZ_SUBMIT_PER_MINUTE=10
